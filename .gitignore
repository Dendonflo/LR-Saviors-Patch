# Copies of the retail executable, patched or otherwise (98 MB)
patched_exe/

# Extracted game archives - .wdb / .xwp / packed scene data (22 MB)
game_data_extracted/

# Extracted and decompiled game scripts: the engine's Java-classfile resources

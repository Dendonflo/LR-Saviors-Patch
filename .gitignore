# their output is not.
script_research/

# A single extracted .clb script resource
Ghysal patch/

# Ghidra decompiler output of LRFF13.exe (3.6 GB). Regenerable from the
# scripts in tools/ghidra_scripts against your own copy of the game.
ghidra_output/
tools/ghidra_output/

# The Ghidra project database - contains the imported game binary (588 MB)
tools/ghidra_project/


// VERSIONINFO for dinput8.dll. An unsigned DLL with NO version block is
// "anonymous" to every antivirus classifier; this is the cheapest of the PE
// hygiene features they weigh (2026-09-17). Compiled by rc.exe in build.cmd.
#include <winres.h>
#include "version_num.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    MOD_VER_MAJOR,MOD_VER_MINOR,MOD_VER_PATCH,0
 PRODUCTVERSION MOD_VER_MAJOR,MOD_VER_MINOR,MOD_VER_PATCH,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Dendonflo"
            VALUE "FileDescription",  "Savior's Patch - performance and graphics mod for Lightning Returns: Final Fantasy XIII"
            VALUE "FileVersion",      MOD_VERSION_STR
            VALUE "InternalName",     "SaviorsPatch"
            VALUE "LegalCopyright",   "GNU General Public License v3"
            VALUE "OriginalFilename", "dinput8.dll"
            VALUE "ProductName",      "Savior's Patch"
            VALUE "ProductVersion",   MOD_VERSION_STR
            VALUE "Comments",         "Open source: https://github.com/Dendonflo/LR-Saviors-Patch"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
